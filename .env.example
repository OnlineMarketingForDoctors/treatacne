# Supabase project (Sydney region). The publishable key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://txihhbfywmwkzmuxklqb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never commit or paste in chat; set it in Vercel > Project > Settings > Environment Variables.
SUPABASE_SECRET_KEY=

# New-submission notification email (Resend). Without RESEND_API_KEY the email is skipped.
RESEND_API_KEY=
RESEND_FROM="Treat:Acne <notifications@treatacne.com.au>"
NOTIFY_EMAIL=info@treatacne.com.au

# Public site address used in email links (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=https://treatacne.com.au
